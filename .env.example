# Copie este arquivo para .env (gitignored) e preencha os valores.
# Gere um AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=

# Fora do Docker: diretório absoluto, persistente e gravável pela aplicação.
PRODUCT_IMAGES_DIR=/var/lib/boxshop/product-images
# Produção: pasta do host (disco ou NFS já montado); obrigatória no Compose prod.
PRODUCT_IMAGES_HOST_DIR=
