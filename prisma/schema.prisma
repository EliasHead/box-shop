generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Multi-Tenant Isolation
model Tenant {
  id        String   @id @default(cuid())
  description String?
  whatsapp    String?
  domain    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  products   Product[]
  categories Category[]
}

// NextAuth Next.js Default Schema with Tenant Relation
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // ADMIN, OWNER, USER

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Base product schema
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  price       Float
  status      String   @default("DRAFT") // ACTIVE or DRAFT
  sku         String?
  imageKey    String?

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stock          Int      @default(0)
  trackInventory Boolean  @default(true)

  variationTypes ProductVariationType[]
  variants       ProductVariant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
}

// Sem relação com Product: a limpeza precisa sobreviver à exclusão do produto.
model ImageCleanup {
  id          String   @id @default(cuid())
  imageKey    String   @unique
  lastError   String
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Variations Support
model ProductVariationType {
  id        String   @id @default(cuid())
  name      String   // e.g. "Cor"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  options   ProductVariationOption[]
  
  @@unique([productId, name])
}

model ProductVariationOption {
  id               String               @id @default(cuid())
  value            String               // e.g. "Azul"
  variationTypeId  String
  variationType    ProductVariationType @relation(fields: [variationTypeId], references: [id], onDelete: Cascade)
  
  variants         ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku       String?
  price     Float?
  stock     Int      @default(0)
  
  options   ProductVariationOption[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([productId, sku])
}
